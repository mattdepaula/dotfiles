# vim: set filetype=dosini:

[user]
	# don't guess identity; fail explicitly if user.email isn't set per-repo
	useConfigOnly = true
[core]
	editor = vim
	# faster status/diff on large repos (requires Git 2.37+)
	fsmonitor = true
	untrackedCache = true
[diff]
	renames = copies
	submodule = diff
	mnemonicPrefix = true
	algorithm = histogram
	colorMoved = plain
[rerere]
	# remember and reuse conflict resolutions across rebases
	enabled = true
	autoUpdate = true
[branch]
	# new branches rebase instead of merge on pull
	autoSetupRebase = always
	sort = -committerdate
[column]
	ui = auto
[merge]
	autoStash = true
	# disallow merge commits; fast-forward only
	ff = only
	# show common ancestor in conflict markers
	conflictStyle = zdiff3
[log]
	decorate = short
	follow = true
[mergetool]
	keepBackup = false
	trustExitCode = true
[help]
	autocorrect = prompt
[status]
	submoduleSummary = true
[rebase]
	autoStash = true
	# error if a commit line is deleted during interactive rebase
	missingCommitsCheck = error
	updateRefs = true
	instructionFormat = %<|(-58,trunc)%s | %<(15,trunc)%an | %ar
	autoSquash = true
[stash]
	showPatch = true
[push]
	default = current
	autoSetupRemote = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[advice]
	skippedCherryPicks = false
	# suppress detached HEAD warning — intentional advanced use
	detachedHead = false
[commit]
	# show diff in commit message editor
	verbose = true
# https://github.com/tummychow/git-absorb
[absorb]
	maxStack = 50
	oneFixupPerCommit = true
	autoStageIfNothingStaged = true
	fixupTargetAlwaysSHA = false
[include]
	path = ~/.config/git/config.local
[pager]
	status = true
[feature]
	# opt into experimental Git 3.x behaviors
	git3 = true
[tag]
	sort = version:refname
