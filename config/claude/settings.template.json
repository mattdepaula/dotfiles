{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "env": {
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(mise:*)",
      "Bash(mkdir:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(osascript:*)",
      "Bash(python3:*)",
      "Bash(rm:*)",
      "Bash(sqlite3:*)",
      "Bash(wrangler:*)",
      "Skill(agentic-patterns:*)",
      "Skill(daily-ops:*)",
      "Skill(interaction-standards:*)",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*"
    ],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(npm i --global:*)",
      "Bash(npm i -g:*)",
      "Bash(npm install --global:*)",
      "Bash(npm install -g:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)"
    ],
    "ask": [
      "Bash(gh api*repos*/pulls:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(op:*)",
      "Bash(open:*)",
      "Bash(sudo:*)",
      "Bash(trash -fr:*)",
      "Bash(trash -r:*)",
      "Bash(trash -rf:*)",
      "Edit(CLAUDE.md)",
      "Edit(~/.bashrc)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshrc)",
      "Read(~/.ssh/**)",
      "Write(CLAUDE.md)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "padding": 0
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "verbose": true,
  "teammateMode": "auto",
  "voiceEnabled": true
}
